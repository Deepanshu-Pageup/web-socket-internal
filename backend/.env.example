# Placeholders only. Never commit real credentials.
# kid:secret pairs, comma separated; each secret must be at least 32 random characters.
AUTH_TOKEN_KEYS=key1:replace-with-a-long-random-secret-of-32-or-more-characters
AUTH_DEPLOYMENT_ID=replace-with-deployment-id
AUTH_TOKEN_MAX_LIFETIME_S=300
AUTH_CLOCK_SKEW_S=5
HOST=0.0.0.0
PORT=6001
LOG_LEVEL=info
ALLOWED_ORIGINS=
SHUTDOWN_TIMEOUT_MS=10000
WS_PATH=/ws
WS_MAX_PAYLOAD_BYTES=65536
WS_PING_INTERVAL_MS=30000
WS_MAX_CONNECTIONS=10000
WS_MAX_BUFFERED_BYTES=1048576
